(version 1)

# OpenDrone canonical design rules.
#
# Copied from hardware-template into every board repo. Keep the block above the
# marker byte-identical across repos. Board-specific rules go
# below the marker, never in the middle.
#
# This file holds CUSTOM rules only. The fab numbers that gate a JLCPCB order
# live in the project file under board.design_settings.rules, and come from
# Board Setup > Import Settings from Another Board, pointed at
# kicad/templates/OpenDrone-6L. The line standard is:
#
#   clearance 0.09   track 0.09   via 0.35 / 0.20 drill
#   annular 0.075    hole-to-hole 0.20        edge clearance 0.20
#
# Do not restate those here. Two copies of a number drift, and the one you are
# not looking at is the one that is wrong.

(rule "silkscreen over pad"
  (constraint silk_clearance (min 0.15mm))
  (condition "A.Type == 'Pad'"))

# --- board-specific rules below this line ------------------------------------
#
# Only what this board needs and the line does not. Name every rule so the next
# person can tell a real constraint from a copied one.
#
# NextPCB extreme tier, OpenAIO Base: 8L 1.6 mm, 2 oz finished outer, 1 oz
# inner, through vias with Non-Conductive Fill & Cap (IPC-4761 VII) where they
# sit in pads. Through vias only (D8, owner rule): no microvia rule. Every
# number and its source: research/review-2026-10/NEXTPCB.md sections 2.2 and
# 3.3. These replace the earlier 0.16 mm "2 oz outer copper" pair. KiCad: the
# LAST matching rule wins, per constraint; general rules first, specific last.

(rule "NPCB base: outer 2 oz track"
  (layer outer)
  (constraint track_width (min 0.14mm)))

(rule "NPCB base: outer 2 oz clearance"
  (layer outer)
  (constraint clearance (min 0.14mm)))

# TODO-R3: pours on the outer layers keep the 0.16 mm they were filled and
# reviewed with. At 0.14 the highest-priority F.Cu +BATT pour (priority 32,
# whole board) fits between the /1C motor pad and Q7's source pins and cuts the
# phase-node pour (1 unconnected). R3 re-plans the power-stage pours and their
# priorities (D3, D6); delete this rule there. Tracks and pads get 0.14.
(rule "TODO-R3: outer pours keep 0.16 until the power-stage re-plan"
  (layer outer)
  (condition "A.Type == 'Zone' || B.Type == 'Zone'")
  (constraint clearance (min 0.16mm)))

(rule "NPCB base: inner 1 oz track"
  (layer inner)
  (constraint track_width (min 0.10mm)))

(rule "NPCB base: inner 1 oz clearance"
  (layer inner)
  (constraint clearance (min 0.10mm)))

(rule "NPCB base: SMD pad to SMD pad"
  (layer outer)
  (condition "A.Type == 'Pad' && B.Type == 'Pad' && A.Pad_Type == 'SMD' && B.Pad_Type == 'SMD'")
  (constraint clearance (min 0.15mm)))

(rule "NPCB base: PTH pad to PTH pad"
  (condition "A.Type == 'Pad' && B.Type == 'Pad' && A.Pad_Type == 'Through-hole' && B.Pad_Type == 'Through-hole'")
  (constraint clearance (min 0.40mm)))

(rule "NPCB base: through via, 1.6 mm board"
  (condition "A.Type == 'Via' && A.Via_Type == 'Through'")
  (constraint hole_size (min 0.20mm))
  (constraint via_diameter (min 0.43mm))
  (constraint annular_width (min 0.115mm))
  (constraint hole_clearance (min 0.18mm)))

# TODO-R3: every Base via is still a 0.075 mm ring (1280 x 0.35/0.20, 47 x
# 0.50/0.30, 4 x 0.45/0.25); NextPCB 2 oz wants 0.43/0.20 (0.115 ring). The R3
# re-route resizes them with the stack re-plan (D3). Until then this rule holds
# DRC at today's via so ~1330 known items do not bury new findings. It only
# relaxes via_diameter and annular_width; hole size and hole clearance above
# still apply. Delete this rule in R3.
(rule "TODO-R3: Base vias stay 0.35/0.20 until the R3 re-route"
  (condition "A.Type == 'Via' && A.Via_Type == 'Through'")
  (constraint via_diameter (min 0.35mm))
  (constraint annular_width (min 0.075mm)))

(rule "NPCB base: PTH hole to copper"
  (condition "A.Type == 'Pad' && A.Pad_Type == 'Through-hole'")
  (constraint hole_clearance (min 0.23mm))
  (constraint annular_width (min 0.115mm)))

(rule "NPCB base: NPTH hole to copper"
  (condition "A.Type == 'Pad' && A.Pad_Type == 'NPTH, mechanical'")
  (constraint hole_clearance (min 0.20mm)))

(rule "NPCB base: hole to hole, different nets (CAF)"
  (condition "A.Net != B.Net")
  (constraint hole_to_hole (min 0.30mm)))

(rule "NPCB base: copper to routed edge"
  (constraint edge_clearance (min 0.20mm)))

# Reported under courtyards_overlap, a warning in the project file since R3-E.
# Courtyards here are still the library's padded ones, so most hits are not
# real; the real check is the fab-body gap (review lr_density.py).
(rule "NPCB base: body to body (courtyard drawn on the body)"
  (constraint courtyard_clearance (min 0.20mm)))

# Intended edge pads (R3-E). copper_edge_clearance is an error in the project
# file; these rules exempt only pads that are meant to sit at or over the routed
# edge. Each condition starts with A.Type == 'Pad': U24 owns the Edge.Cuts
# outline, so a footprint-only condition would also match the edge itself and
# switch the check off for the whole board. Everything else keeps the 0.20 mm
# rule above.

(rule "Edge pads: U24 battery and motor solder pads"
  (constraint edge_clearance (min 0.20mm))
  (severity ignore)
  (condition "A.Type == 'Pad' && A.memberOfFootprint('U24') && (A.Pad_Number == '1' || A.Pad_Number == '2' || A.Pad_Number == '12' || A.Pad_Number == '13' || A.Pad_Number == '14' || A.Pad_Number == '15' || A.Pad_Number == '16' || A.Pad_Number == '17' || A.Pad_Number == '18' || A.Pad_Number == '19' || A.Pad_Number == '20' || A.Pad_Number == '21' || A.Pad_Number == '22' || A.Pad_Number == '23')"))

(rule "Edge pads: USB1 shell tabs (pad 0)"
  (constraint edge_clearance (min 0.20mm))
  (severity ignore)
  (condition "A.Type == 'Pad' && A.memberOfFootprint('USB1') && A.Pad_Number == '0'"))

(rule "Edge pads: J15-J33 wire pads (lib:small_pad)"
  (constraint edge_clearance (min 0.20mm))
  (severity ignore)
  (condition "A.Type == 'Pad' && A.memberOfFootprint('lib:small_pad')"))

# Not exempt, left for the owner (R3-E): JP1.1 (U.FL centre pad, 0.37 mm past
# the 0.20 line), FL1.2 (2.4 GHz filter GND pad, 0.19 mm), U12.7/.8 (SM06B
# shell tabs, 0.69 mm). Each needs a part move.

# LGA J90 land (DFM-06, decision D2). Copper of another net next to a hidden
# LGA joint cannot be inspected or reworked, and +BATT next to an FC signal is
# the worst short on the board. Pours of every other net keep 0.30 mm from
# every J90 pad, and +BATT keeps 0.30 mm with every item type (J90 carries no
# +BATT pad). Measured on the refilled board, FB1: +BATT path resistance
# unchanged within 0.005 mOhm (research/review-2026-10/lr_power.py method).
(rule "LGA J90: other-net pours 0.30 from the land"
  (layer "F.Cu")
  (condition "A.memberOfFootprint('J90') && B.Type == 'Zone' && A.Net != B.Net")
  (constraint clearance (min 0.30mm)))

(rule "LGA J90: +BATT 0.30 from the land"
  (layer "F.Cu")
  (condition "A.memberOfFootprint('J90') && B.Net == '+BATT'")
  (constraint clearance (min 0.30mm)))

# Solder mask (DFM-12): expansion 0.04 mm and minimum web 0.09 mm (NextPCB
# green) in board setup. A gang opening is allowed only inside a datasheet
# land pattern whose pad gaps are below 0.17 mm (2 x 0.04 + 0.09); keep it only
# after NextPCB accepts the gang (NEXTPCB.md 4.6, question 11). KiCad 10.0.6
# evaluates bridged_mask on item A only (an A && B condition never matches),
# so each rule names the footprint; FB1 checked that no bridge leaves it.
(rule "Mask gang: U23 X2SON-4 land pattern"
  (constraint bridged_mask)
  (condition "A.memberOfFootprint('U23')")
  (severity ignore))
