(footprint "MotorPad"
  (version 20240108)
  (generator "OpenAIO")
  (layer "F.Cu")
  (descr "Single-phase motor solder pad. Place 3 per motor (A/B/C). Hand-solder only (no paste). Sized for ~30A continuous per phase on 1oz copper.")
  (tags "motor solder pad fpv esc brushless")
  (attr smd exclude_from_pos_files)
  (fp_text reference "REF**" (at 0 -2.1) (layer "F.SilkS")
    (effects (font (size 0.7 0.7) (thickness 0.12)))
  )
  (fp_text value "MotorPad" (at 0 2.1) (layer "F.Fab")
    (effects (font (size 0.6 0.6) (thickness 0.1)))
  )
  (fp_line (start -1.2 -1.5) (end -1.2 1.5) (stroke (width 0.1) (type solid)) (layer "F.CrtYd"))
  (fp_line (start -1.2  1.5) (end  1.2 1.5) (stroke (width 0.1) (type solid)) (layer "F.CrtYd"))
  (fp_line (start  1.2  1.5) (end  1.2 -1.5) (stroke (width 0.1) (type solid)) (layer "F.CrtYd"))
  (fp_line (start  1.2 -1.5) (end -1.2 -1.5) (stroke (width 0.1) (type solid)) (layer "F.CrtYd"))
  (pad "1" smd roundrect (at 0 0) (size 2.0 2.5) (layers "F.Cu" "F.Mask")
    (roundrect_rratio 0.25)
    (solder_mask_margin 0.1)
  )
)
