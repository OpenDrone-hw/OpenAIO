(footprint "BatteryPad"
  (version 20240108)
  (generator "OpenAIO")
  (layer "F.Cu")
  (descr "Single battery solder pad. Place 2 per input (+ / -). Hand-solder only (no paste). Sized for ~90A burst, 30A continuous on 1oz copper.")
  (tags "battery solder pad fpv lipo 6s")
  (attr smd exclude_from_pos_files)
  (fp_text reference "REF**" (at 0 -3.6) (layer "F.SilkS")
    (effects (font (size 0.8 0.8) (thickness 0.15)))
  )
  (fp_text value "BatteryPad" (at 0 3.6) (layer "F.Fab")
    (effects (font (size 0.7 0.7) (thickness 0.12)))
  )
  (fp_line (start -2.2 -3.2) (end -2.2 3.2) (stroke (width 0.1) (type solid)) (layer "F.CrtYd"))
  (fp_line (start -2.2  3.2) (end  2.2 3.2) (stroke (width 0.1) (type solid)) (layer "F.CrtYd"))
  (fp_line (start  2.2  3.2) (end  2.2 -3.2) (stroke (width 0.1) (type solid)) (layer "F.CrtYd"))
  (fp_line (start  2.2 -3.2) (end -2.2 -3.2) (stroke (width 0.1) (type solid)) (layer "F.CrtYd"))
  (pad "1" smd roundrect (at 0 0) (size 4.0 6.0) (layers "F.Cu" "F.Mask")
    (roundrect_rratio 0.2)
    (solder_mask_margin 0.1)
  )
)
